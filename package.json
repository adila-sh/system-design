{
  "name": "adila-ui-registry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run registry && vite build && node scripts/fix-tslib.mjs",
    "registry": "node scripts/gen-registry.mjs && node scripts/gen-docs.mjs && shadcn build",
    "start": "node .output/server/index.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@types/bun": "^1.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.11.3",
    "fumadocs-ui": "^16.11.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fumadocs-mdx": "^15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "shadcn": "^4.13.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.4"
  }
}
