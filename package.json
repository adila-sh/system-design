{
  "name": "adila-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "build": "bun run --cwd packages/ui build && bun run --cwd apps/docs build",
    "start": "bun run --cwd apps/docs start",
    "test": "bun run --cwd packages/ui test",
    "test:coverage": "bun run --cwd packages/ui test:coverage",
    "test:changed": "bun run --cwd packages/ui test:changed",
    "test:related": "bun run --cwd packages/ui test:related",
    "test:shuffle": "bun run --cwd packages/ui test:shuffle",
    "test:status": "bun run --cwd apps/docs test:test-status && bun run --cwd packages/ui test:json && bun run --cwd apps/docs gen:test-status",
    "typecheck": "bun run --cwd packages/ui typecheck && bun run --cwd apps/docs typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": [
      "oxfmt --write"
    ]
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  }
}
