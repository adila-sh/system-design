{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/only-export-components": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "**/.output",
    "**/.nitro",
    "node_modules",
    "apps/docs/src/routeTree.gen.ts",
    ".agents/skills/*",
    "!.agents/skills/use-adila-sidebar/"
  ]
}
